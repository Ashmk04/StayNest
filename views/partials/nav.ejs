<header class="fixed inset-x-0 top-0 z-50 bg-rose-500 shadow-md">
    <input type="checkbox" id="nav-toggle" class="peer hidden">

    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">

        <a href="/" class="text-2xl font-extrabold tracking-tight text-white">
            StayNest
        </a>

        <ul class="hidden items-center gap-1 md:flex">

            <% if(isLoggedin){ %>
                <% if(user.userType === "guest"){ %>
                    <li>
                        <a href="/StayNestHomes" class="block rounded-full px-3 py-1.5 text-sm font-semibold transition <%= currentPage === 'Homes' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                            Explore Homes
                        </a>
                    </li>
                    <li>
                        <a href="/my-bookings" class="block rounded-full px-3 py-1.5 text-sm font-semibold transition <%= currentPage === 'Bookings' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                            My Bookings
                        </a>
                    </li>
                    <li>
                        <a href="/favHomes" class="block rounded-full px-3 py-1.5 text-sm font-semibold transition <%= currentPage === 'Favourite' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                            Favourites
                        </a>
                    </li>
                <% }else{ %>
                    <li>
                        <a href="/add-home" class="block rounded-full px-3 py-1.5 text-sm font-semibold transition <%= currentPage === 'add-home' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                            List Your Home
                        </a>
                    </li>
                    <li>
                        <a href="/listedHomes" class="block rounded-full px-3 py-1.5 text-sm font-semibold transition <%= currentPage === 'listedHomes' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                            My Listings
                        </a>
                    </li>
                <% } %>
            <% } %>

            <% if(!isLoggedin) { %>
                <li>
                    <a href="/signup" class="block rounded-full px-3 py-1.5 text-sm font-semibold transition <%= currentPage === 'signup' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                        SignUp
                    </a>
                </li>
                <li>
                    <a href="/login" class="block rounded-full px-3 py-1.5 text-sm font-semibold transition <%= currentPage === 'login' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                        Login
                    </a>
                </li>
            <% } else { %>
                <li>
                    <form action="/logout" method="POST">
                        <button type="submit" class="cursor-pointer rounded-full px-3 py-1.5 text-sm font-semibold text-white/90 transition hover:bg-white/10 hover:text-white">
                            Logout
                        </button>
                    </form>
                </li>
            <% } %>

        </ul>

        <label for="nav-toggle" class="cursor-pointer rounded-md p-2 text-white md:hidden" aria-label="Toggle menu">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </label>

    </div>

    <ul class="hidden flex-col gap-1 bg-rose-500 px-4 pb-4 peer-checked:flex md:hidden">

        <% if(isLoggedin){ %>
            <% if(user.userType === "guest"){ %>
                <li>
                    <a href="/StayNestHomes" class="block rounded-lg px-3 py-2 text-sm font-semibold transition <%= currentPage === 'Homes' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                        Explore Homes
                    </a>
                </li>
                <li>
                    <a href="/my-bookings" class="block rounded-lg px-3 py-2 text-sm font-semibold transition <%= currentPage === 'Bookings' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                        My Bookings
                    </a>
                </li>
                <li>
                    <a href="/favHomes" class="block rounded-lg px-3 py-2 text-sm font-semibold transition <%= currentPage === 'Favourite' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                        Favourites
                    </a>
                </li>
            <% }else{ %>
                <li>
                    <a href="/add-home" class="block rounded-lg px-3 py-2 text-sm font-semibold transition <%= currentPage === 'add-home' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                        List Your Home
                    </a>
                </li>
                <li>
                    <a href="/listedHomes" class="block rounded-lg px-3 py-2 text-sm font-semibold transition <%= currentPage === 'listedHomes' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                        My Listings
                    </a>
                </li>
            <% } %>
        <% } %>

        <% if(!isLoggedin) { %>
            <li>
                <a href="/signup" class="block rounded-lg px-3 py-2 text-sm font-semibold transition <%= currentPage === 'signup' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                    SignUp
                </a>
            </li>
            <li>
                <a href="/login" class="block rounded-lg px-3 py-2 text-sm font-semibold transition <%= currentPage === 'login' ? 'bg-white text-rose-600' : 'text-white/90 hover:bg-white/10 hover:text-white' %>">
                    Login
                </a>
            </li>
        <% } else { %>
            <li>
                <form action="/logout" method="POST">
                    <button type="submit" class="w-full cursor-pointer rounded-lg px-3 py-2 text-left text-sm font-semibold text-white/90 transition hover:bg-white/10 hover:text-white">
                        Logout
                    </button>
                </form>
            </li>
        <% } %>

    </ul>

</header>
