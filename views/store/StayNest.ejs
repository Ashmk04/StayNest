<%- include("../partials/head") %>
</head>

<%- include("../partials/nav") %>
 
<body class="min-h-screen bg-gray-50 pt-16">

    <section class="bg-gradient-to-b from-rose-50 to-gray-50 px-4 py-14 text-center sm:py-20 ">

        <% if(isLoggedin){ %>
            <% if(user.userType === "host"){ %>

                <h1 class="text-3xl font-bold text-rose-500 sm:text-4xl md:text-5xl">
                    Turn your home into a stay
                </h1>
                <p class="mx-auto mt-3 max-w-xl text-sm text-gray-500 sm:text-base">
                    Share your space with guests and start earning from your property.
                </p>

                <a href="add-home" class="mt-6 inline-block rounded-lg bg-rose-500 px-6 py-2.5 font-semibold
            text-white shadow-md transition duration-200 hover:bg-rose-600">
                List Your Home
                </a>

            <% }else if(user.userType === "guest"){ %>
                    
                <div class="mb-8">
                    <h1 class="text-3xl font-bold text-gray-800">
                        Find Your Perfect Stay
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Discover comfortable homes, unique stays, and memorable places for your next trip.
                    </p>
                </div>

            <% } %>
        <% }else{ %>


                <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800">
            Find Your Perfect Stay
        </h1>

        <p class="text-gray-500 mt-2">
            Discover comfortable homes, unique stays, and memorable places for your next trip.
        </p>
    </div>
            
        
        <% } %>


       
    </section>

    <main class="mx-auto max-w-7xl px-4 py-1 sm:px-6 lg:px-8">

        <% if(registeredHomes.length === 0){ %>
            <p class="rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center text-gray-500">
                No homes have been listed yet.
            </p>
        <% } else { %>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                <% registeredHomes.forEach(home=> { %>
                    <article class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:shadow-lg">

                        <div class="relative aspect-[4/3] w-full overflow-hidden bg-gray-100">
                            <img src="<%= home.image %>" alt="<%= home.houseName %>" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                            <span class="absolute right-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-gray-800 shadow">
                                ⭐ <%= home.rating %>
                            </span>
                        </div>

                        <div class="flex flex-1 flex-col gap-1.5 p-4">
                            <h2 class="truncate text-lg font-bold text-gray-900">
                                <%= home.houseName %>
                            </h2>
                            <p class="truncate text-sm text-gray-500">
                                📍 <%= home.location %>
                            </p>
                            <p class="truncate text-sm text-gray-500">
                                ☎️ <%= home.contact %>
                            </p>

                            <p class="mt-1 text-lg font-bold text-gray-900">
                                🏷️ <%= home.price %> <span class="text-sm font-normal text-gray-500">/ night</span>
                            </p>

                            <div class="mt-3 flex items-center gap-2">
                                
                                <%- include("../partials/details",{home:home}) %>

                                <%- include("../partials/book",{home:home}) %>
                               
                                <%- include("../partials/favourites", {home:home}) %>

                            </div>
                        </div>

                    </article>
                    <% }) %>
            </div>
        <% } %>

    </main>

</body>

</html>
