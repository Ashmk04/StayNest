<%- include("../partials/head") %>
</head>

<%- include("../partials/nav") %>

<body class="min-h-screen bg-gray-50 pt-16">

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">

        <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800">
            My Favourites
        </h1>

        <p class="text-gray-500 mt-2">
            View and manage your favourite stays.
        </p>
    </div>

        <% if(favouriteHomes.length === 0){ %>
            <p class="rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center text-gray-500">
                You haven't added any homes to your favourites yet.
            </p>
        <% } else { %>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                <% favouriteHomes.forEach(home=> { %>
                    <article class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:shadow-lg">

                        <div class="relative aspect-[4/3] w-full overflow-hidden bg-gray-100">
                            <img src="<%= home.image %>" alt="<%= home.houseName %>" class="h-full w-full object-cover transition duration-300 group-hover:scale-105" />
                            <span class="absolute right-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-gray-800 shadow">
                                ⭐ <%= home.rating %>
                            </span>
                        </div>

                        <div class="flex flex-1 flex-col gap-1.5 p-4">
                            <h2 class="truncate text-lg font-bold text-gray-900">
                                <%= home.houseName %>
                            </h2>
                            <p class="truncate text-sm text-gray-500">
                                📍 <%= home.location %>
                            </p>
                            <p class="truncate text-sm text-gray-500">
                                ☎️ <%= home.contact %>
                            </p>

                            <p class="mt-1 text-lg font-bold text-gray-900">
                                🏷️ <%= home.price %> <span class="text-sm font-normal text-gray-500">/ night</span>
                            </p>

                            <div class="mt-3 flex items-center gap-2">
                                <%- include("../partials/details",{home:home}) %>

                                <%- include("../partials/book",{home:home}) %>
                               
                                <form action="/deleteFavouriteHome/<%=home._id%>" method="POST">
                                    <button
                                        type="submit"
                                        aria-label="Remove from favourites"
                                        class="inline-flex h-9 w-9 items-center justify-center rounded-full text-xl transition hover:scale-110 hover:bg-rose-50 cursor-pointer">
                                        ❤️
                                    </button>
                                </form>
                            </div>
                        </div>

                    </article>
                    <% }) %>
            </div>
        <% } %>

    </main>

</body>

</html>
